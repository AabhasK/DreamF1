# Backend settings (read by backend/app/config.py via python-dotenv).
# Copy to backend/.env for local runs. On EC2 this lives at /opt/myf1circle/.env.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=dreamf1
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me
ALGORITHM=HS256

# Frontend settings (frontend/.env.local, or Vercel project env vars).
# Leave empty so the browser calls relative /api/*, handled by app/api/[...path]/route.ts.
NEXT_PUBLIC_API_URL=
# Unset = demo mode (serves frontend/demo-data snapshots). "false" = proxy to API_URL.
DEMO_MODE=false
API_URL=http://localhost:8080
